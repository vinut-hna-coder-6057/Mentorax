# Database; Connector/J is required to use encrypted transport for MySQL.
# MySQL requires sslMode=VERIFY_IDENTITY and a readable CA truststore.
# DB_CA_TRUSTSTORE_PATH=/path/to/aiven-ca-truststore.p12
# DB_CA_TRUSTSTORE_TYPE=PKCS12
# DB_CA_TRUSTSTORE_PASSWORD=<set-in-local-secret-manager>
DB_URL=jdbc:mysql://localhost:3306/alumni_connect
DB_USERNAME=root
DB_PASSWORD=change_me

# Required for email verification and password-reset OTP delivery. Also used by
# event-registration email notifications. Use a verified Resend sender.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@your-verified-domain.example

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=3600000

WEBSOCKET_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Process-local HTTP rate limits; configure a shared limiter before scaling out.
RATE_LIMIT_LOGIN_IP=60
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_OTP_IP=20
RATE_LIMIT_OTP_EMAIL=5
RATE_LIMIT_WINDOW_MS=900000

# STOMP send limiter and asynchronous email outbox.
WEBSOCKET_RATE_LIMIT_MESSAGES=60
WEBSOCKET_RATE_LIMIT_WINDOW_MS=60000
EMAIL_OUTBOX_ENABLED=true
EMAIL_OUTBOX_POLL_DELAY_MS=5000

# Optional, on-demand local mentor ranking service (disabled by default).
AI_MENTOR_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8090
AI_MENTOR_RANKING_STRATEGY=tfidf
# Required by Python ranking when enabled; set the same random secret on Python.
AI_MENTOR_API_TOKEN=replace_with_a_random_internal_service_secret
# Minimum normalized Java profile-token overlap (0..1). Zero still requires a positive match.
# This is a configurable starting point, not a scientifically calibrated threshold.
AI_MENTOR_MIN_RELEVANCE=0.0

# Optional alumni inbox assistant; use the same high-entropy secret in Java and Python.
AI_INBOX_ASSISTANT_ENABLED=false
INBOX_ASSISTANT_API_TOKEN=replace_with_a_random_secret

# Python ranker settings. Install requirements-semantic.txt only to enable semantic/hybrid mode.
MENTOR_RANKING_STRATEGY=tfidf
MENTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MENTOR_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
MENTOR_HYBRID_TFIDF_WEIGHT=0.5

# Required for private evidence storage: Base64-encoded 32-byte AES key.
# Store the real key in deployment secrets, never in source control.
EXPERIENCE_EVIDENCE_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
# Optional internal Python analysis token; keep separate from the encryption key.
EXPERIENCE_ANALYSIS_API_TOKEN=replace_with_a_shared_random_secret

# Python service policy. Production fails closed for protected routes with missing tokens.
MENTOR_ENVIRONMENT=development
MENTOR_API_DOCS_ENABLED=false
MENTOR_RANKING_API_TOKEN=replace_with_the_same_secret_as_AI_MENTOR_API_TOKEN

# Knowledge Companion LLM is opt-in. Keep credentials server-side and use only
# after reviewing third-party processing terms for alumni contribution excerpts.
KNOWLEDGE_ANSWER_PROVIDER=deterministic
# OPENAI_API_KEY is intentionally not populated in this template.
KNOWLEDGE_OPENAI_MODEL=gpt-4.1-mini
KNOWLEDGE_PROVIDER_TIMEOUT_MS=20000
KNOWLEDGE_ANSWER_CACHE_ENABLED=true
KNOWLEDGE_ANSWER_CACHE_WAIT_MS=22000
KNOWLEDGE_ANSWER_CACHE_LOCK_LEASE_SECONDS=60
KNOWLEDGE_ANSWER_CACHE_TTL_STABLE_DAYS=30
KNOWLEDGE_ANSWER_CACHE_TTL_PREPARATION_DAYS=14
KNOWLEDGE_ANSWER_CACHE_TTL_COMPANY_DAYS=7
KNOWLEDGE_ANSWER_CACHE_TTL_CYCLE_DAYS=3
