#database
DB_URL=jdbc:mysql://localhost:3306/alumni_connect
DB_USERNAME=root
DB_PASSWORD=change_me

# Required for email verification and password-reset OTP delivery. Also used by
# event-registration email notifications. Use a verified Resend sender.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@your-verified-domain.example

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=3600000

WEBSOCKET_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Process-local HTTP rate limits; configure a shared limiter before scaling out.
RATE_LIMIT_LOGIN_IP=60
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_OTP_IP=20
RATE_LIMIT_OTP_EMAIL=5
RATE_LIMIT_WINDOW_MS=900000

# STOMP send limiter and asynchronous email outbox.
WEBSOCKET_RATE_LIMIT_MESSAGES=60
WEBSOCKET_RATE_LIMIT_WINDOW_MS=60000
EMAIL_OUTBOX_ENABLED=true
EMAIL_OUTBOX_POLL_DELAY_MS=5000

# Optional, on-demand local mentor ranking service (disabled by default).
AI_MENTOR_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8090
AI_MENTOR_RANKING_STRATEGY=tfidf
# Minimum normalized Java profile-token overlap (0..1). Zero still requires a positive match.
# This is a configurable starting point, not a scientifically calibrated threshold.
AI_MENTOR_MIN_RELEVANCE=0.0

# Python ranker settings. Install requirements-semantic.txt only to enable semantic/hybrid mode.
MENTOR_RANKING_STRATEGY=tfidf
MENTOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MENTOR_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
MENTOR_HYBRID_TFIDF_WEIGHT=0.5
