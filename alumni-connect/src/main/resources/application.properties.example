# =========================================
# MYSQL DATABASE
# =========================================

server.port=${PORT:8080}
# MySqlTlsUrlPostProcessor adds sslMode=VERIFY_IDENTITY when absent and rejects weaker modes.
# Set DB_CA_TRUSTSTORE_PATH, DB_CA_TRUSTSTORE_PASSWORD, and optionally
# DB_CA_TRUSTSTORE_TYPE=PKCS12 to a protected truststore containing the official Aiven CA.
spring.datasource.url=${DB_URL}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${DB_USERNAME:${MYSQLUSER}}
spring.datasource.password=${DB_PASSWORD:${MYSQLPASSWORD}}
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB

# =========================================
# JPA / HIBERNATE
# =========================================
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.flyway.enabled=true
management.endpoints.web.exposure.include=health
management.endpoint.health.probes.enabled=true
management.endpoint.health.group.readiness.include=readinessState,db
management.endpoint.health.show-details=never
management.endpoint.health.show-components=always
management.endpoint.health.group.readiness.show-components=never

# =====================================
# EMAIL CONFIGURATION
# =====================================

# Required for signup email verification and password-reset OTP delivery; also
# used for event-registration email notifications. Set RESEND_API_KEY and
# RESEND_FROM_EMAIL in the environment, using a verified Resend sender.
app.email-outbox.enabled=${EMAIL_OUTBOX_ENABLED:true}
app.email-outbox.poll-delay-ms=${EMAIL_OUTBOX_POLL_DELAY_MS:5000}


# =========================================
# SECURITY
# =========================================

jwt.secret=${JWT_SECRET}
jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}
app.websocket.allowed-origins=${WEBSOCKET_ALLOWED_ORIGINS}
app.cors.allowed-origin-patterns=${CORS_ALLOWED_ORIGIN_PATTERNS}

# Process-local abuse protection (use shared storage for multi-instance deployments)
app.rate-limit.login-ip=${RATE_LIMIT_LOGIN_IP:60}
app.rate-limit.login-email=${RATE_LIMIT_LOGIN_EMAIL:10}
app.rate-limit.otp-ip=${RATE_LIMIT_OTP_IP:20}
app.rate-limit.otp-email=${RATE_LIMIT_OTP_EMAIL:5}
app.rate-limit.window-ms=${RATE_LIMIT_WINDOW_MS:900000}
app.websocket.rate-limit.messages=${WEBSOCKET_RATE_LIMIT_MESSAGES:60}
app.websocket.rate-limit.window-ms=${WEBSOCKET_RATE_LIMIT_WINDOW_MS:60000}

# Knowledge Companion answer generation (default is deterministic and requires no key).
app.knowledge.answer-provider=${KNOWLEDGE_ANSWER_PROVIDER:deterministic}
app.knowledge.ollama.base-url=${KNOWLEDGE_OLLAMA_BASE_URL:http://127.0.0.1:11434}
app.knowledge.ollama.model=${KNOWLEDGE_OLLAMA_MODEL:gemma3:1b}
app.knowledge.openai.api-key=${OPENAI_API_KEY:}
app.knowledge.openai.model=${KNOWLEDGE_OPENAI_MODEL:gpt-4.1-mini}
app.knowledge.provider.timeout-ms=${KNOWLEDGE_PROVIDER_TIMEOUT_MS:20000}
app.knowledge.cache.enabled=${KNOWLEDGE_ANSWER_CACHE_ENABLED:true}
app.knowledge.cache.cleanup-delay-ms=${KNOWLEDGE_ANSWER_CACHE_CLEANUP_DELAY_MS:3600000}
app.knowledge.cache.single-flight-wait-ms=${KNOWLEDGE_ANSWER_CACHE_WAIT_MS:22000}
app.knowledge.cache.lock-lease-seconds=${KNOWLEDGE_ANSWER_CACHE_LOCK_LEASE_SECONDS:60}
app.knowledge.cache.ttl.stable-days=${KNOWLEDGE_ANSWER_CACHE_TTL_STABLE_DAYS:30}
app.knowledge.cache.ttl.preparation-days=${KNOWLEDGE_ANSWER_CACHE_TTL_PREPARATION_DAYS:14}
app.knowledge.cache.ttl.company-days=${KNOWLEDGE_ANSWER_CACHE_TTL_COMPANY_DAYS:7}
app.knowledge.cache.ttl.cycle-days=${KNOWLEDGE_ANSWER_CACHE_TTL_CYCLE_DAYS:3}
