# =========================================
# MYSQL DATABASE
# =========================================

server.port=${PORT:8080}
spring.datasource.url=${DB_URL}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# =========================================
# JPA / HIBERNATE
# =========================================
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.flyway.enabled=true
management.endpoints.web.exposure.include=health
management.endpoint.health.probes.enabled=true
management.endpoint.health.group.readiness.include=readinessState,db
management.endpoint.health.show-details=never
management.endpoint.health.show-components=always

# =====================================
# EMAIL CONFIGURATION
# =====================================

# Required for signup email verification and password-reset OTP delivery; also
# used for event-registration email notifications. Set RESEND_API_KEY and
# RESEND_FROM_EMAIL in the environment, using a verified Resend sender.
app.email-outbox.enabled=${EMAIL_OUTBOX_ENABLED:true}
app.email-outbox.poll-delay-ms=${EMAIL_OUTBOX_POLL_DELAY_MS:5000}


# =========================================
# SECURITY
# =========================================

jwt.secret=${JWT_SECRET}
jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}
app.websocket.allowed-origins=${WEBSOCKET_ALLOWED_ORIGINS}
app.cors.allowed-origin-patterns=${CORS_ALLOWED_ORIGIN_PATTERNS}

# Process-local abuse protection (use shared storage for multi-instance deployments)
app.rate-limit.login-ip=${RATE_LIMIT_LOGIN_IP:60}
app.rate-limit.login-email=${RATE_LIMIT_LOGIN_EMAIL:10}
app.rate-limit.otp-ip=${RATE_LIMIT_OTP_IP:20}
app.rate-limit.otp-email=${RATE_LIMIT_OTP_EMAIL:5}
app.rate-limit.window-ms=${RATE_LIMIT_WINDOW_MS:900000}
app.websocket.rate-limit.messages=${WEBSOCKET_RATE_LIMIT_MESSAGES:60}
app.websocket.rate-limit.window-ms=${WEBSOCKET_RATE_LIMIT_WINDOW_MS:60000}
